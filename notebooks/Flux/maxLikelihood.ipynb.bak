   "source": [
    "flight_data_allE = np.sum(flight_data_cube, axis=0)\n",
    "model_all_E = np.sum(model, axis=0)\n",
    "\n",
    "print(f\"DEBUG : flight data allE shape : {flight_data_allE.shape}\")\n",
    "print(f\"DEBUG : model allE shape : {model_all_E.shape}\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 6))\n",
    "fig1, ax1 = plt.subplots(figsize=(8, 6))\n",
    "im = plot_counts_map(fig, ax, roi_lon_edges, roi_lat_edges, model_all_E.T, E_bin_centers_valid[e_bin],\n",
    "                     target_lon, target_lat, target)\n",
    "\n",
    "im = plot_counts_map(fig1, ax1, roi_lon_edges, roi_lat_edges, flight_data_allE.T, E_bin_centers_valid[e_bin],\n",
