   "source": [
    "# Plot model vs data counts maps for all valid energy bins\n",
    "n_bins = len(E_bin_centers_valid)\n",
    "fig, axs = plt.subplots(n_bins, 2, figsize=(12, 4 * n_bins))\n",
    "\n",
    "for idx in range(n_bins):\n",
    "    # Model map\n",
    "    ax_model = axs[idx, 0]\n",
    "    total_model = np.sum(model[idx])\n",
    "    im_model = ax_model.imshow(\n",
    "        model[idx].T, origin='lower',\n",
    "        extent=[\n",
    "            np.rad2deg(roi_lon_edges[0]), np.rad2deg(roi_lon_edges[-1]),\n",
    "            np.rad2deg(roi_lat_edges[0]), np.rad2deg(roi_lat_edges[-1])\n",
    "        ],\n",
    "        aspect='auto'\n",
    "    )\n",
    "    ax_model.set_title(f\"Model (E={E_bin_centers_valid[idx]:.2f} GeV, {total_model:.0f} Counts)\")\n",
    "    ax_model.set_xlabel('Galactic longitude [deg]')\n",
    "    ax_model.set_ylabel('Galactic latitude [deg]')\n",
    "    ax_model.xaxis.set_inverted(True)\n",
    "    fig.colorbar(im_model, ax=ax_model, orientation='vertical')\n",
    "\n",
    "    # Data map\n",
    "    ax_data = axs[idx, 1]\n",
    "    total_data = np.sum(flight_data_cube[idx])\n",
    "    im_data = ax_data.imshow(\n",
    "        flight_data_cube[idx].T, origin='lower',\n",
    "        extent=[\n",
    "            np.rad2deg(roi_lon_edges[0]), np.rad2deg(roi_lon_edges[-1]),\n",
    "            np.rad2deg(roi_lat_edges[0]), np.rad2deg(roi_lat_edges[-1])\n",
    "        ],\n",
    "        aspect='auto'\n",
    "    )\n",
    "    ax_data.set_title(f\"Data Counts (E={E_bin_centers_valid[idx]:.2f} GeV, {total_data:.0f} Counts)\")\n",
    "    ax_data.set_xlabel('Galactic longitude [deg]')\n",
    "    ax_data.set_ylabel('Galactic latitude [deg]')\n",
    "    ax_data.xaxis.set_inverted(True)\n",
    "    fig.colorbar(im_data, ax=ax_data, orientation='vertical')\n",
    "\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
