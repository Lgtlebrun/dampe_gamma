     ]
    }
   ],
   "source": [
    "isotropic_convolved = isotropic_maps.copy()\n",
    "for i, (iso, psf) in enumerate(zip(isotropic_maps, PSF_kernels_valid)):\n",
    "    isotropic_convolved[i] = convolve(iso, psf)\n",
    "\n",
    "verbose = True \n",
    "if verbose :\n",
    "    print(f\"isotropic convolved shape : {isotropic_convolved.shape}\")"
   ]
