     "text": [
      "npix = [19. 19. 19. 19. 25. 25. 25. 33. 33. 33. 33. 33. 33. 33.  7.  7.  3.  3.\n",
      "  5.  5.]\n"
     ]
    }
   ],
   "source": [
    "# Identify according PSF energy bin for each exposure energy bin\n",
    "Epsf_bins = np.digitize(E_bin_centers, PSF_E_bins_edge) - 1\n",
    "Epsf_bins = np.clip(Epsf_bins, 0, len(PSF_E_bins_edge) - 2)\n",
    "\n",
    "Sp_per_E_deg = np.array([Sp_per_Epsf_deg[e] for e in Epsf_bins])\n",
    "\n",
    "verbose = False\n",
    "if verbose :\n",
    "    print(f\"DEBUG : Epsf_bins : {Epsf_bins}\")\n",
    "    print(f\"DEBUG : to check : Ebinscenters = {E_bin_centers}\")\n",
    "    print(f\"DEBUG : and PSF_E_bins_edge : {PSF_E_bins_edge}\")\n",
    "\n",
    "dlon_rad = np.abs(roi_lon_edges[1] - roi_lon_edges[0])\n",
    "dlat_rad = np.abs(roi_lat_edges[1] - roi_lat_edges[0])\n",
    "dlon_deg = np.rad2deg(dlon_rad)\n",
    "dlat_deg = np.rad2deg(dlat_rad)\n",
    "verbose = False\n",
    "if verbose :\n",
    "    print(f'dlon_rad : {dlon_rad}, dlat_rad : {dlat_rad}')\n",
    "    print(f'dlon_deg : {dlon_deg}, dlat_rad : {dlat_deg}')\n",
    "\n",
    "# Identify roi_radius : min(4, 2*Sp) TODO : increase binning of exposure map to allow 2*Sp in any case\n",
    "roi_radii_deg = np.ones_like(Epsf_bins, dtype=np.float64)\n",
    "roi_radii_deg *= np.array([np.min((2., 2*Sp)) for Sp in Sp_per_E_deg])\n",
    "\n",
    "if verbose:\n",
    "    print(f'roi_radii_deg : {roi_radii_deg}')\n",
    "\n",
    "# Get ceiled odd number of pixels\n",
    "roi_radii_rad = np.deg2rad(roi_radii_deg)\n",
    "npix = 2* roi_radii_rad // dlon_rad\n",
    "npix = np.where(npix % 2 == 1 , npix, npix + 1)\n",
    "\n",
    "if verbose:\n",
    "    print(f'npix = {npix}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 130,
   "id": "8af95e7e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def crop_exposure_map(exposure_map, npix):\n",
    "    \"\"\"\n",
    "    Crop square exposure_map(s) to shape (npix, npix), centered.\n",
    "\n",
    "    Args:\n",
    "        exposure_map (np.ndarray): 2D array (N,N) or 3D array (M,N,N)\n",
    "        npix (int or array-like): Desired output size(s) (must be odd and <= N)\n",
    "\n",
    "    Returns:\n",
    "        np.ndarray: Cropped exposure map(s) of shape (npix, npix) or (M, npix, npix)\n",
    "    \"\"\"\n",
    "    arr = np.asarray(exposure_map)\n",
    "    if arr.ndim == 2:\n",
    "        arr = arr[None, ...]\n",
    "    N = arr.shape[1]\n",
    "    assert arr.shape[1] == arr.shape[2], \"Input must be square\"\n",
    "    npix = np.atleast_1d(npix)\n",
    "    if npix.size == 1:\n",
    "        npix = np.full(arr.shape[0], npix[0], dtype=int)\n",
    "    assert npix.shape[0] == arr.shape[0], \"npix must match number of maps\"\n",
    "\n",
    "    cropped = []\n",
    "    for i, n in enumerate(npix):\n",
    "        assert n % 2 == 1, \"npix must be odd\"\n",
    "        assert n <= N, \"npix must be <= N\"\n",
    "        n = int(n)\n",
    "        center = N // 2\n",
    "        half = n // 2\n",
    "        start = center - half\n",
    "        end = center + half + 1\n",
    "        cropped.append(arr[i, start:end, start:end])\n",
    "    return cropped if exposure_map.ndim == 3 else cropped[0]\n",
    "\n"
   ]
  },
