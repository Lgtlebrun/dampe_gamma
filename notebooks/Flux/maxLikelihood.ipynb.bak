    }
   ],
   "source": [
    "# Get worse angular resolution per energy bin\n",
    "\n",
    "Sp_per_Epsf_deg = np.array([resolution_per_bin.loc[resolution_per_bin['E_bin'] == i]['angular_resolution'].max() for i in range(len(PSF_E_bins_center))])\n",
    "verbose = True\n",
    "if verbose:\n",
    "    print(f\"S_p per E : {Sp_per_Epsf_deg}\")\n",
    "\n",
    "Sp_per_Epsf_rad = np.deg2rad(Sp_per_Epsf_deg)"
